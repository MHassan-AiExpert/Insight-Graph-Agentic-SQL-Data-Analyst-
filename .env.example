# ---- LLM ----------------------------------------------------------
# Create a free key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low (fastest) / medium / high
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0

# ---- Database -----------------------------------------------------
# Default: the bundled SQLite sample database (created on first start).
# PostgreSQL example (install psycopg[binary]):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/analytics
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=500

# ---- Agent --------------------------------------------------------
MAX_SQL_ATTEMPTS=3
HISTORY_TURNS=5

# ---- API ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
